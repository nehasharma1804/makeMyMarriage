# Copy to .env using npm run setup. Leave MONGODB_URI empty to run without a database.
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info
MONGODB_URI=
MONGODB_DB_NAME=make_my_marriage_dev
MONGODB_TIMEOUT_MS=5000
# Local option: mongodb://127.0.0.1:27017
# Atlas option: paste the Node.js driver URI into .env only, never this file.

# Reserved for later features. These integrations are not implemented yet.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=
AWS_REGION=ap-south-1
S3_BUCKET=
CLOUDFRONT_DOMAIN=
# Obtain MongoDB values from Atlas and Google client ID from Google Cloud Console.
# AWS configuration can wait until media development. Never commit secrets.
