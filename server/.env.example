# Copy to .env using npm run setup. Leave MONGODB_URI empty to run without a database.
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info
MONGODB_URI=
MONGODB_DB_NAME=make_my_marriage_dev
MONGODB_TIMEOUT_MS=5000
# Local option: mongodb://127.0.0.1:27017/?replicaSet=rs0
# Atlas option: paste the Node.js driver URI into .env only, never this file.

WEB_ORIGIN=http://localhost:3000
# Generate and save without displaying the value: npm run setup:auth
SESSION_SECRET=
SESSION_TTL_HOURS=168
# A local database must use a replica set for atomic wedding creation.
# Configure an Atlas database or the documented optional local replica set.

# Reserved for later media features.
AWS_REGION=ap-south-1
S3_BUCKET=
CLOUDFRONT_DOMAIN=
# AWS configuration can wait until media development. Never commit secrets.
